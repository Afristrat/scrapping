# =============================================================================
# Kairos Frontend — build multi-stage pour le bundle Enterprise self-hosted
# =============================================================================
# S'inspire du Dockerfile racine (utilisé par Coolify cloud) mais cible le
# déploiement on-premise via docker-compose.enterprise.yml.
#
# Différences avec Dockerfile racine :
#   - Build args VITE_* injectés au build (URLs internes Docker)
#   - nginx config étendue : SPA fallback + reverse proxy vers Kong
#   - Health check intégré
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 : build TypeScript + Vite
# -----------------------------------------------------------------------------
FROM node:20-alpine AS build
WORKDIR /app

# Dépendances séparées pour profiter du cache Docker
COPY package.json package-lock.json* .npmrc ./
RUN npm install --legacy-peer-deps

# Code source
COPY . .

# Variables Vite injectées au build (REQUIS — Vite inline les env au build)
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

# Build production (tsc strict + vite build)
RUN npm run build

# -----------------------------------------------------------------------------
# Stage 2 : nginx minimal pour servir dist + reverse proxy
# -----------------------------------------------------------------------------
FROM nginx:1.27-alpine

# Bundle statique
COPY --from=build /app/dist /usr/share/nginx/html

# Config nginx (SPA fallback + proxy /auth, /rest, /storage, /functions vers Kong)
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf

# Health check : le frontend doit répondre 200 sur /healthz
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost/healthz || exit 1

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
